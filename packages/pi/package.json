{
  "name": "pi-yee-stack",
  "version": "0.5.0",
  "description": "A small stack of extensions for Pi: Wish Specializer (/wish), read-only Q&A Ask mode (/ask), browser control with $tN tabs (/browser), and a tabbed /yee-config page.",
  "type": "module",
  "license": "MIT",
  "author": "akirousnow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akirousnow/pi-yee-stack.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/akirousnow/pi-yee-stack#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "prompt-engineering",
    "ask-mode",
    "browser-control",
    "chrome-devtools-mcp",
    "tui",
    "coding-agent"
  ],
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/test-support/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx src/config-store.test.ts && tsx src/shortcut.test.ts && tsx src/legacy.test.ts && tsx src/features/ask/mode.test.ts && tsx src/features/browser/tools.test.ts && tsx src/features/browser/mode.test.ts && tsx src/features/browser/autocomplete.test.ts && tsx src/features/browser/tab.test.ts && tsx src/ui/config-page.test.ts",
    "test:e2e": "tsx src/features/browser/e2e.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "~1.5.2",
    "yee-stack-ask": "^0.5.0",
    "yee-stack-browser": "^0.5.0",
    "yee-stack-core": "^0.5.0",
    "yee-stack-wish": "^0.5.0",
    "chrome-devtools-mcp": "~1.13.0",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
