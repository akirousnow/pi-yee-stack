{
  "name": "@yee-stack/dsh",
  "version": "0.5.0",
  "description": "Yee Stack for DeepSeek Harness: Wish Specializer (/wish), read-only Ask mode (/ask), and Chrome control through chrome-devtools-mcp (/browser).",
  "type": "module",
  "license": "MIT",
  "author": "akirousnow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akirousnow/pi-yee-stack.git",
    "directory": "packages/dsh"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "src/",
    "locale/*.json",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx src/tests/ask.test.ts && tsx src/tests/wish.test.ts && tsx src/tests/browser.test.ts && tsx src/tests/config.test.ts"
  },
  "dependencies": {
    "@yee-stack/ask": "*",
    "@yee-stack/browser": "*",
    "@yee-stack/core": "*",
    "@yee-stack/wish": "*",
    "chrome-devtools-mcp": "~1.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22.19.0"
  }
}
