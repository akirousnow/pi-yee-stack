{
  "name": "@yee-stack/core",
  "version": "0.5.0",
  "description": "Host-agnostic core of Yee Stack: wish prompts, ask policy, browser tab refs/snapshots, chrome-devtools-mcp connection planning, and the shared config schema.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx src/config-schema.test.ts && tsx src/shortcut.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
