{
  "name": "pi-yee-stack",
  "version": "0.3.0",
  "description": "A small stack of extensions for Pi: Wish Specializer (/wish), read-only Q&A Ask mode (/ask), and a tabbed /yee-config page.",
  "type": "module",
  "license": "MIT",
  "author": "akirousnow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akirousnow/pi-yee-stack.git"
  },
  "bugs": {
    "url": "https://github.com/akirousnow/pi-yee-stack/issues"
  },
  "homepage": "https://github.com/akirousnow/pi-yee-stack#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "prompt-engineering",
    "ask-mode",
    "tui",
    "coding-agent"
  ],
  "files": [
    "extensions/",
    "!extensions/**/*.test.ts",
    "!extensions/**/test-support/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx extensions/yee-stack/config.test.ts && tsx extensions/yee-stack/shortcut.test.ts && tsx extensions/yee-stack/legacy.test.ts && tsx extensions/yee-stack/features/wish/prompt.test.ts && tsx extensions/yee-stack/features/ask/policy.test.ts && tsx extensions/yee-stack/features/ask/mode.test.ts && tsx extensions/yee-stack/ui/config-page.test.ts",
    "test": "npm run typecheck && npm run test:unit"
  },
  "pi": {
    "extensions": [
      "./extensions/yee-stack/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
